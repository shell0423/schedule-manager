# LINE Messaging API（新規作成する公式アカウント）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 通知先（自分の LINE userId。友だち追加後に Webhook の source.userId から確認）
LINE_USER_ID=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Webhook サーバー
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5555
# VPS 中継経由で署名が保たれないなら false に
VERIFY_SIGNATURE=true
